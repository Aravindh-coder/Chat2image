# GEMINI_API_KEY: Required for Gemini AI API calls (conversational intelligence, prompt enhancement).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# IMAGE_PROVIDER: Choice of image generation provider:
# - 'pollinations' (Free AI image generation with Flux/SDXL, no key needed)
# - 'gemini' (Uses Gemini image models if available on your key)
# - 'custom' (Uses IMAGE_API_KEY with custom provider)
# - 'demo' (Demo mode with visual watermarked demo previews)
IMAGE_PROVIDER="pollinations"

# IMAGE_API_KEY: Optional API key for third-party image generation services
IMAGE_API_KEY=""

# DATABASE_PATH: Path to SQLite database file
DATABASE_PATH="./chat2image.sqlite"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

